{
  "name": "agent-chat-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "prisma generate && next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run tests/magica.live.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "trigger:dev": "trigger dev",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/sync-contracts.mjs --check",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/backend": "3.23.2",
    "@clerk/nextjs": "7.9.14",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@trigger.dev/sdk": "4.7.3",
    "dotenv": "17.2.3",
    "next": "16.4.0",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "msw",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@trigger.dev/build": "4.7.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "msw": "2.11.3",
    "prisma": "7.10.0",
    "trigger.dev": "4.7.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
