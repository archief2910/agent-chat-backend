# PostgreSQL. Use the pooled URL for the app and the direct URL for migrations when your host splits them.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_chat
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_chat

# Clerk. The backend verifies Bearer session tokens minted by the frontend origin.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWT_KEY=
FRONTEND_ORIGIN=http://localhost:3000

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_replace_me
TRIGGER_PROJECT_REF=proj_replace_me

# OpenRouter. The model is a literal: the server refuses any other value.
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Magica. Server-side only. Never expose this to the browser, prompts, or logs.
MAGICA_API_KEY=gx_replace_me
MAGICA_BASE_URL=https://inference.magica.com

# Public URL of this API, sent as OpenRouter's HTTP-Referer.
APP_BASE_URL=http://localhost:3001

# 1 credit = 1_000_000 microcredits (Magica estimate-credits docs).
# Admission is the refundable hold taken when a turn starts. 5000 = one Crop Image.
CREDIT_ADMISSION_MICROCREDITS=5000
# Granted once, the first time a Clerk user is seen. 10000000 = 10 credits.
INITIAL_CREDIT_MICROCREDITS=10000000

# Approvals. Trigger.dev deletes a stream left empty for about an hour, so the timeout is capped at 55.
WAITPOINT_TIMEOUT_MINUTES=30
# Billable tools at or above this estimate pause for a credit approval. 0 turns it off.
# 1000000 = 1 credit. This is a placeholder until the reference product's rule is confirmed.
CREDIT_APPROVAL_THRESHOLD_MICROCREDITS=1000000

# Transloadit (Community plan). Uploads return 503 until all three are set.
TRANSLOADIT_AUTH_KEY=
TRANSLOADIT_AUTH_SECRET=
TRANSLOADIT_TEMPLATE_ID=
# Defaults to APP_BASE_URL/api/v1/uploads/notify. Must be publicly reachable.
TRANSLOADIT_NOTIFY_URL=
# Template step whose results are the stored copies (for example the step before an S3 store step).
TRANSLOADIT_RESULT_STEP=
UPLOAD_MONTHLY_BYTES=5000000000
UPLOAD_MAX_FILE_BYTES=500000000
UPLOAD_MAX_FILES=8

MAX_MESSAGE_CHARS=32000
SEND_RATE_LIMIT_PER_MINUTE=20
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_DURATION_MS=900000
LOG_LEVEL=info
